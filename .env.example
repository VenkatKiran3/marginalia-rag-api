# --- LLM (required for /api/ask; ingestion and search work without it) ---
# You can also paste the Gemini key in the web UI: Settings (gear icon).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative provider: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high — answer synthesis from short excerpts needs little reasoning
LLM_EFFORT=low
LLM_MAX_TOKENS=4000
# Re-run a request on a fallback model if a safety classifier declines it
LLM_SERVER_FALLBACKS=true

# --- Embeddings (local, no key) ---
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking & retrieval ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=8
# Questions whose best passage scores below this skip the LLM and are reported as unavailable
MIN_RELEVANCE=0.5

# --- Storage ---
DATA_DIR=data
MAX_UPLOAD_MB=20
# Index this folder on first start (when the index is empty). Leave empty to disable.
SEED_DIR=sample_docs
